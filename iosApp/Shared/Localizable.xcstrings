    "New notes will wait here until you have a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Notizen warten hier, bis du eine Minute Zeit hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas nuevas te esperan aquí hasta que tengas un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles notes vous attendent ici jusqu’à ce que vous ayez une minute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note nuove ti aspettano qui finché hai un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメモは、時間ができるまでここで待っています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas novas esperam aqui até você ter um minuto."
          }
        }
