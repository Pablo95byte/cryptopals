        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがマイクを使用している可能性があります。少し待ってからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Talvez outro app esteja usando o microfone. Tente de novo em instantes."
          }
        }
      }
