<?xml version="1.0" encoding="utf-8"?>
<!--
    I colori dell'app (D46). Due famiglie, e non vanno mescolate:

    - la **scrivania** (desk, text_*, chip, accent): lo sfondo e i testi dell'interfaccia,
      che cambiano col tema scuro;
    - la **carta** (paper, card, on_paper_*): i fogli e i bigliettini, che restano chiari
      anche di notte. L'inchiostro è scuro, e un foglio scuro lo renderebbe invisibile:
      di notte le note diventano bigliettini chiari su una scrivania scura;
    - il **foglio** (sheet_*): la superficie di scrittura. È l'unica eccezione: di notte si
      scurisce e l'inchiostro diventa chiaro (D52), perché chi scrive a letto al buio non
      deve essere accecato. È solo un modo di mostrare: i tratti salvati non cambiano (D7).
-->
<resources>
    <!-- Il campo dell'icona (D71): solo nell'icona, mai nell'interfaccia. -->
    <color name="brand_field">#E2532B</color>
    <!-- La goccia (D72): nell'interfaccia vuol dire solo "da smistare". -->
    <color name="spark">#E4572E</color>

    <color name="paper">#FBF8F1</color>
    <color name="card">#FFFDF8</color>
    <color name="on_paper">#1F2430</color>
    <color name="on_paper_muted">#8B8374</color>

    <color name="sheet_paper">#FBF8F1</color>
    <color name="sheet_card">#FFFDF8</color>
    <color name="sheet_ink">#1F2430</color>
    <color name="sheet_muted">#8B8374</color>

    <color name="desk">#F3EFE7</color>
    <color name="text_primary">#1F2430</color>
    <color name="text_secondary">#7D7668</color>
    <color name="chip">#E9E3D7</color>
    <color name="outline">#E0D8C8</color>
    <color name="accent">#1F2430</color>
    <color name="on_accent">#FBF8F1</color>
    <color name="danger">#B4402F</color>
    <color name="ripple">#1F1F2430</color>
</resources>
