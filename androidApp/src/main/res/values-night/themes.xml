<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Di notte: scrivania scura, barre con icone chiare. I fogli restano carta. -->
    <style name="Theme.InkNote" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/desk</item>
        <item name="android:windowBackground">@color/desk</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Il foglio è carta anche di notte: icone scure sulle barre. -->
    <style name="Theme.InkNote.Capture" parent="Theme.InkNote">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
