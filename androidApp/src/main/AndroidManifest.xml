<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        La fotocamera dentro il foglio (D45). Non obbligatoria: su un dispositivo senza
        fotocamera l'app si installa lo stesso, e l'icona non fa niente.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkNote">

        <!--
            La schermata di cattura.

            android:showWhenLocked  compare sopra il blocco senza sbloccare (D17).
            android:turnScreenOn    accende lo schermo se era spento.
            android:directBootAware può girare prima del primo sblocco dopo un
                                    riavvio, perché il giornale sta in area
                                    protetta dal dispositivo e non dalle credenziali.
            android:launchMode      singleTop: due tocchi rapidi non aprono due fogli.
            android:excludeFromRecents  le app recenti mostrano un'istantanea dello
                                    schermo, cioè la nota: fuori dall'app non si
                                    legge nessuna nota (invariante 11, D34).
            android:configChanges   ruotare il telefono non ricrea il foglio.
                                    Ricrearlo spezzerebbe la nota in due, e toglierebbe
                                    dallo schermo l'inchiostro appena scritto.
            android:windowSoftInputMode  con la tastiera aperta (D38) il foglio si
                                    restringe invece di finirci sotto, e OK resta visibile.

            Non è più l'attività dell'icona: l'icona apre l'archivio (D39). Al foglio si
            arriva dal widget, dal riquadro rapido, dalla scorciatoia e da "Scrivi".
        -->
        <activity
            android:name=".CaptureActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.InkNote.Capture"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize" />

        <!--
            "Scrivi": una seconda voce nell'elenco delle app, che apre direttamente il
            foglio (D39). Serve a chi la vuole nel dock, e a chi assegna un'app al tasto
            laterale: sui Samsung, doppia pressione del tasto laterale → Scrivi.
        -->
        <activity-alias
            android:name=".WriteAlias"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/capture_label"
            android:targetActivity=".CaptureActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- L'archivio: si apre toccando l'icona dell'app (D39). -->
        <activity
            android:name=".ArchiveActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".NoteActivity"
            android:exported="false" />

        <!-- La ricevuta del foglio di condivisione: registra l'invio (D31). -->
        <receiver
            android:name=".ShareResultReceiver"
            android:exported="false" />

        <!--
            I file delle note per la fotocamera e per le app di destinazione (D40).

            In un processo suo, ":files": un ContentProvider del processo principale
            verrebbe creato a ogni avvio, prima del foglio (invariante 21). Così nasce solo
            quando un'altra app chiede un file. Non esportato: ci si arriva solo con un
            permesso concesso da noi, indirizzo per indirizzo.
        -->
        <provider
            android:name=".FilesProvider"
            android:authorities="app.inknote.android.files"
            android:directBootAware="true"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":files" />

        <activity
            android:name=".RecoveredNotesActivity"
            android:exported="false"
            android:label="@string/recovered_title" />

        <!--
            Il widget della home (D30, D33): RemoteViews di piattaforma, non Glance.
        -->
        <receiver
            android:name=".SheetWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sheet_info" />
        </receiver>

        <!--
            Il riquadro delle impostazioni rapide: l'ingresso a telefono bloccato (D17,
            D33). directBootAware come la cattura, così funziona anche prima del primo
            sblocco dopo un riavvio.
        -->
        <service
            android:name=".CaptureTileService"
            android:directBootAware="true"
            android:exported="true"
            android:icon="@drawable/ic_scribble"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
