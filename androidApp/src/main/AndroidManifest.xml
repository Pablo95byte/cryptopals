<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkNote">

        <!--
            La schermata di cattura.

            android:showWhenLocked  compare sopra il blocco senza sbloccare (D17).
            android:turnScreenOn    accende lo schermo se era spento.
            android:directBootAware può girare prima del primo sblocco dopo un
                                    riavvio, perché il giornale sta in area
                                    protetta dal dispositivo e non dalle credenziali.
            android:launchMode      singleTop: due tocchi rapidi non aprono due fogli.
        -->
        <activity
            android:name=".CaptureActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.InkNote.Capture"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RecoveredNotesActivity"
            android:exported="false"
            android:label="@string/recovered_title" />

    </application>

</manifest>
